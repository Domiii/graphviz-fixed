digraph LeftStaysLeft {
  /* Notes right of spine. Free corridor is left of Mid, not Notes far outer. */
  rankdir=TB;
  nodesep=0.4;
  ranksep=0.5;
  splines=polyline;
  node [shape=box];

  Top [group=spine];
  Mid [group=spine];
  Gap [group=spine];
  Bot [group=spine];
  Note [shape=note];

  Top -> Mid -> Gap -> Bot;
  Bot -> Top [constraint=false label="back"];
  Mid -> Note [style=dotted arrowhead=none];
  { rank=same; Mid; Note; }
}
