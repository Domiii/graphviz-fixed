digraph interior_w_mixed {
  // right-column port cells; :w ports lie inside the table (cell side LEFT not on the table side)
  t [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
    <TR><TD>Agent</TD><TD PORT="r0">spawn 0</TD></TR>
    <TR><TD>Read</TD><TD PORT="r1">read</TD></TR>
    <TR><TD>Agent</TD><TD PORT="r2">spawn 2</TD></TR>
    <TR><TD>Agent</TD><TD PORT="r3">spawn 3</TD></TR>
    <TR><TD>Read</TD><TD PORT="r4">read</TD></TR>
    <TR><TD>Agent</TD><TD PORT="r5">spawn 5</TD></TR>
    <TR><TD>Read</TD><TD PORT="r6">read</TD></TR>
    <TR><TD>Agent</TD><TD PORT="r7">spawn 7</TD></TR>
    <TR><TD>Agent</TD><TD PORT="r8">spawn 8</TD></TR>
    <TR><TD>Agent</TD><TD PORT="r10">spawn 10</TD></TR>
    <TR><TD>Agent</TD><TD PORT="r12">spawn 12</TD></TR>
    <TR><TD>Agent</TD><TD PORT="r14">spawn 14</TD></TR>
  </TABLE>>];
  p -> t;
  t -> a0 [tailport="r0:w"];
  t -> a2 [tailport="r2:e"];
  t -> a3 [tailport="r3:w"];
  t -> a5 [tailport="r5:w"];
  t -> a7 [tailport="r7:w"];
  t -> a8 [tailport="r8:e"];
  t -> a10 [tailport="r10:e"];
  t -> a12 [tailport="r12:w"];
  t -> a14 [tailport="r14:w"];
}
