digraph same_port_fan {
  // several edges leave one port, between ports with one edge each
  t [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
    <TR><TD COLSPAN="2"><B>agent</B></TD></TR>
    <TR><TD>Agent</TD><TD PORT="r0">Explore: a</TD></TR>
    <TR><TD>Agent</TD><TD PORT="r1">Explore: b, c, d</TD></TR>
    <TR><TD>Agent</TD><TD PORT="r2">Explore: e</TD></TR>
  </TABLE>>];
  p -> t;
  t -> a [tailport="r0:e"];
  t -> b [tailport="r1:e"];
  t -> c [tailport="r1:e"];
  t -> d [tailport="r1:e"];
  t -> e [tailport="r2:e"];
}
